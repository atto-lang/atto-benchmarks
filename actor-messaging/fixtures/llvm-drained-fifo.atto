// Correctness preflight for the restricted native actor source profile.
// Explicit flush means STOP may not silently abandon DATA.
define actor Worker as {
  let digest: int = 0;
  pub fnc on_message(int n): int {
    digest = digest * 11 + n;
    return digest;
  }
}
pub fnc main(): int {
  const worker: ActorRef<Worker> = spawn Worker();
  worker.send(1);
  worker.send(2);
  worker.send(3);
  worker.send(4);
  worker.send(5);
  worker.send(6);
  worker.send(7);
  worker.send(8);
  worker.send(9);
  worker.send(10);
  worker.flush_blocking();
  stop worker;
  return 43;
}
